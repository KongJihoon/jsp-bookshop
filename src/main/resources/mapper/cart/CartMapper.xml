<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="hello.bookshop.cart.mapper.CartMapper">

    <select id="findCartByMemberId"
            parameterType="long"
            resultType="hello.bookshop.cart.domain.Cart">

        SELECT
            cart_id,
            member_id,
            created_at,
            updated_at
        FROM cart
        WHERE member_id = #{memberId}
    </select>

    <insert id="saveCart"
            parameterType="hello.bookshop.cart.domain.Cart"
            useGeneratedKeys="true"
            keyProperty="cartId">

        INSERT INTO cart (
            member_id
        ) VALUES(
            #{memberId}
        )

    </insert>

    <select id="findCartItemByCartIdAndProductId"
            resultType="hello.bookshop.cart.domain.CartItem">

        SELECT
            cart_item_id,
            cart_id,
            product_id,
            quantity,
            created_at,
            updated_at
        FROM cart_item
        WHERE cart_id = #{cartId} AND product_id = #{productId}

    </select>

    <insert id="saveCartItem"
            parameterType="hello.bookshop.cart.domain.CartItem"
            useGeneratedKeys="true"
            keyProperty="cartItemId">

        INSERT INTO cart_item(
            cart_id,
            product_id,
            quantity
        ) VALUES (
            #{cartId},
            #{productId},
            #{quantity}
        )

    </insert>

    <update id="increaseQuantity">
        UPDATE cart_item
        SET quantity = quantity + #{quantity}, updated_at = NOW()
        WHERE cart_item_id = #{cartItemId}

    </update>


</mapper>